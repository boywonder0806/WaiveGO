# Copy to .env for local dev. Never commit the real .env (covered by the root
# .gitignore's .env* pattern). In production this service reads these from the
# environment directly (e.g. set in infra/docker-compose.yml once this service has
# a block there), not from a checked-in file.

PORT=3001

# Local dev: point at localhost with the port Postgres is actually exposed on.
# In production (on the Droplet): postgresql://waivego:<password>@waivego-db:5432/waivego
# using the container name, over the internal `backend` Docker network.
DATABASE_URL=postgresql://waivego:waivego@localhost:5432/waivego

# In production: http://compreface-ui (the container name, internal network only).
# For local dev against the deployed Droplet, tunnel it first (see infra/README.md)
# and point this at http://localhost:8000 instead.
COMPREFACE_BASE_URL=http://compreface-ui
# The Face Collection service's API key from CompreFace's admin UI (Applications ->
# your app -> the service) — NOT the same as postgres_password etc. in infra/.env.
COMPREFACE_RECOGNITION_API_KEY=
COMPREFACE_SIMILARITY_THRESHOLD=0.8

SMARTWAIVER_BASE_URL=https://api.smartwaiver.com
# A published key generated in the Smartwaiver console (Settings -> API/Webhooks).
SMARTWAIVER_API_KEY=
