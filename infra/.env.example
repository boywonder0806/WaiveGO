# Copy to `.env` on the Droplet and fill in real values. Never commit the real `.env`
# (it's covered by the root .gitignore's `.env*` pattern).

# ─── CompreFace ──────────────────────────────────────────────────────────────────
# Defaults below match CompreFace's own recommended defaults; bump the version tags
# to whatever's current at https://github.com/exadel-inc/CompreFace/releases when you
# deploy — 1.2.0 was current as of this writing.
registry=exadel/
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0
POSTGRES_VERSION=1.2.0

postgres_username=postgres
postgres_password=CHANGE_ME_use_a_long_random_password
postgres_db=frs
postgres_domain=compreface-postgres-db
postgres_port=5432

enable_email_server=false
email_host=smtp.gmail.com
email_username=
email_from=
email_password=

save_images_to_db=true
# Heap sizes and uwsgi_processes below were tuned against a real OOM crash loop —
# see the memory budget comment at the top of docker-compose.yml for the full story
# and the mem_limit each one needs to stay under. Change them together, not alone.
compreface_api_java_options=-Xmx550m
compreface_admin_java_options=-Xmx300m
max_file_size=5MB
max_request_size=10M
max_detect_size=640
# 1, not CompreFace's own default of 2 — each worker independently loads its own
# full copy of the face/landmarks/age/gender/mask/pose models, so 2 workers means
# 2x the memory footprint. A single kiosk has no need for concurrent workers anyway.
uwsgi_processes=1
uwsgi_threads=1
connection_timeout=10000
read_timeout=60000

# API key for the Face Collection service created inside CompreFace's admin UI
# (Applications -> your app -> the service). Not consumed by anything in this
# compose file directly — this is what services/api will use once it exists to
# call CompreFace's recognize/add-face endpoints. Generated via the admin UI, not
# something to invent a value for here.
compreface_recognition_api_key=

# ─── WaiveGO app database ────────────────────────────────────────────────────────
waivego_db_username=waivego
waivego_db_password=CHANGE_ME_use_a_different_long_random_password
waivego_db_name=waivego

# ─── WaiveGO backend API ─────────────────────────────────────────────────────────
# Optional — see services/api/README.md's "Running without Smartwaiver access".
# Leave blank until real Smartwaiver access exists.
smartwaiver_api_key=
